# ============================================================================
# RAG Teaching API — configuration
# Copy to .env and edit. Full step-by-step credential guides: README.md §Credentials
# ============================================================================
#Comment
# --- server ---------------------------------------------------------------
API_PORT=7799

# --- Qdrant (vector DB — runs in docker; see docker-compose.yml) ----------
# Local run: the compose file maps Qdrant to the rare port 7833.
# Inside docker compose the app overrides this to http://qdrant:6333 automatically.
QDRANT_URL=http://localhost:7833
QDRANT_COLLECTION=libra_rag

# --- chunking defaults (every request may override them) -------------------
# strategies: static | dynamic | sentence | semantic
CHUNK_STRATEGY=dynamic
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SENTENCES_PER_CHUNK=3
SEMANTIC_THRESHOLD=0.75

# --- retrieval / generation defaults ---------------------------------------
TOP_K=4
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500

# --- PROVIDER SELECTION -----------------------------------------------------
# chat:       lmstudio | openai | anthropic | azure
# embeddings: lmstudio | openai | azure     (Anthropic has no embeddings API)
LLM_PROVIDER=azure
EMBEDDING_PROVIDER=azure

# --- LM Studio (local gemma — free, no account) -----------------------------
# README §Credentials·LM Studio: install → download models → start server on 1234.
# From docker compose use: http://host.docker.internal:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-4b
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- OpenAI -----------------------------------------------------------------
# README §Credentials·OpenAI: platform.openai.com → API keys → create.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (chat only) ---------------------------------------------------
# README §Credentials·Anthropic: console.anthropic.com → API keys → create.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Azure Foundry (the course lane) -----------------------------------------
# README §Credentials·Azure Foundry — endpoint looks like:
#   https://<your-resource>.services.ai.azure.com/models
# AZURE_AI_AUTH=identity → keyless via your `az login` (or managed identity).
# AZURE_AI_AUTH=key      → paste a key below (needed inside docker, where az login
#                          isn't available).
AZURE_AI_ENDPOINT=
AZURE_AI_AUTH=identity
AZURE_AI_API_KEY=
AZURE_AI_CHAT_DEPLOYMENT=gpt-5.1
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Agents ------------------------------------------------------------------
# local   = the agent loop runs inside this app (works with ANY provider)
# foundry = the agent is hosted by Azure AI Foundry Agent Service (needs Entra auth)
AGENT_MODE=local
AGENT_PERSONA=default
# Foundry portal → your project → Overview → project endpoint
AZURE_AI_PROJECT_ENDPOINT=
# printed by: uv run python scripts/deploy_agent.py <persona>
FOUNDRY_AGENT_ID=

# --- Azure AI Speech (a SEPARATE resource from Foundry — its own key & region) -
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
AZURE_SPEECH_LANGUAGE=en-US
# Tried in parallel for every /tools/transcribe call unless a language is forced
# explicitly; the transcript with the highest confidence wins. Add more locales
# (comma-separated) if your students speak more than two languages.
AZURE_SPEECH_CANDIDATE_LANGUAGES=ro-RO,en-US

# --- Identity inside a container (optional) ----------------------------------
# A container cannot borrow your `az login`, so the compose default is key auth.
# Keys work for chat and embeddings but NOT for the Agent Service or the control
# plane — both require Microsoft Entra.
#
# To give the container a real identity, create a service principal:
#
#   az ad sp create-for-rbac --name sp-libra-console \
#     --role "Azure AI User" \
#     --scopes $(az cognitiveservices account show --name <resource> \
#                --resource-group <rg> --query id -o tsv)
#
# then paste the three values it prints below and set DOCKER_AZURE_AI_AUTH=identity.
# DefaultAzureCredential tries EnvironmentCredential first, so the code is unchanged.
# Deployed to Azure, the same code uses a managed identity and needs no secret.
DOCKER_AZURE_AI_AUTH=key
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
